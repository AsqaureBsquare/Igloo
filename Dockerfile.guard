FROM --platform=$BUILDPLATFORM golang:1.26-alpine AS builder
ARG TARGETOS
ARG TARGETARCH
WORKDIR /app
COPY . .
RUN CGO_ENABLED=0 GOOS=${TARGETOS} GOARCH=${TARGETARCH} go build -mod=vendor -ldflags="-s -w" -o igloo-guard ./cmd/guard

FROM alpine:3.19
# CA certificates: routes call upstream APIs over HTTPS.
RUN apk add --no-cache ca-certificates && adduser -D -u 10001 guard
USER 10001
COPY --from=builder /app/igloo-guard /usr/local/bin/igloo-guard
EXPOSE 3128
CMD ["igloo-guard"]
