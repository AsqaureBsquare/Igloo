variable "region" {
  default = "us-east-1"
}

variable "app" {
  default = "igloo"
}

variable "server_image" {
  description = "ECR image URI for igloo server (set by deploy script)"
  type        = string
}

variable "workspace_image" {
  description = "ECR image URI for igloo workspace (set by deploy script)"
  type        = string
}

variable "jwt_secret" {
  description = "JWT signing secret — generated by deploy script"
  type        = string
  sensitive   = true
}

variable "provisioner_key" {
  description = "Bootstrap provisioner key — registered on server startup as a named key"
  type        = string
  sensitive   = true
}
