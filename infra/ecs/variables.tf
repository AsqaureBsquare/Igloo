variable "region" {
  default = "us-east-1"
}

variable "app" {
  default = "igloo"
}

variable "server_image" {
  description = "ECR image URI for igloo server (set by deploy script)"
  type        = string
}

variable "workspace_image" {
  description = "ECR image URI for igloo workspace (set by deploy script)"
  type        = string
}

variable "jwt_secret" {
  description = "JWT signing secret — generated by deploy script"
  type        = string
  sensitive   = true
}

variable "provisioner_key" {
  description = "Bootstrap provisioner key — registered on server startup as a named key"
  type        = string
  sensitive   = true
}

variable "server_url" {
  description = "Public URL of the Igloo server (e.g. https://igloos.cloud). Defaults to the ALB HTTP URL if not set."
  type        = string
  default     = ""
}

variable "tailscale_api_key" {
  description = "Tailscale API key — used by server to issue per-workspace auth keys"
  type        = string
  sensitive   = true
  default     = ""
}

variable "tailscale_tailnet" {
  description = "Tailscale tailnet name (e.g. example.com or user@gmail.com)"
  type        = string
  default     = "-"
}
